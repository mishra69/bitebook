{
  "name": "bitebook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "V=$(date +%Y%m%d_%H%M) && BITEBOOK_VERSION=$V vite build && VERSION_OVERRIDE=$V ./deploy.sh",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --strict-vars=false src/worker/worker-configuration.d.ts",
    "migrate": "wrangler d1 migrations apply bitebook-db --remote",
    "migrate:local": "wrangler d1 migrations apply bitebook-db --local",
    "icons": "python3 scripts/make-icons.py"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "jpeg-js": "^0.4.4",
    "preact": "^11.0.1"
  }
}
