{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitebook",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Only the workers.dev URL is used; no per-version preview URLs.
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitebook-db",
      "database_id": "9beafa48-a3b4-44cf-b03e-55b2dc786833",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "bitebook-photos" }],
  // Workers AI: transcribes voice notes (Whisper). Free allowance: 10,000 neurons/day.
  "ai": { "binding": "AI" },
  // Secret (wrangler secret put): SESSION_SECRET. The Google client ID is public and
  // needs no secret (ID-token flow). Until both are set, the API refuses every request.
  "vars": {
    "GOOGLE_CLIENT_ID": "234363181677-1qh9dpevvkr6mtghofllcs8o3gm4pjbi.apps.googleusercontent.com",
    "ALLOWED_EMAILS": "mishabhi@gmail.com",
    // Where the model provider fetches photos from (signed links, src/worker/analyze.ts).
    "APP_ORIGIN": "https://bitebook.mishabhi.workers.dev",
    // Web Push (D25). The private half is a secret: VAPID_PRIVATE_JWK.
    "VAPID_PUBLIC_KEY": "BB1qlQNTJL7VZdgmo5AFvYhzh3PKA4T8B0kh57Jm6qAb7pT1Oj_x885SXPUOgjl8rzk98jhrPiPDY9T7NRDS_MA"
  },
  "observability": { "enabled": true },
  // Each user's clock (D31): a Durable Object whose alarm runs analyses and reminders
  // exactly when they're due. Nothing polls.
  "durable_objects": { "bindings": [{ "name": "CLOCK", "class_name": "UserClock" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserClock"] }],
  // Once a day: the purge of meals deleted more than 30 days ago (src/worker/purge.ts),
  // and a safety net that re-plans every user's clock.
  // Secrets: SESSION_SECRET, VAPID_PRIVATE_JWK, OPENROUTER_API_KEY (the API path, D27).
  "triggers": { "crons": ["17 3 * * *"] }
}
